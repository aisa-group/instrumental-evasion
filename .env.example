# Copy to .env (never commit it). The runner loads it at startup; variables
# already set in the shell take precedence.

# Agent and monitor models reached through OpenRouter (the default monitor is
# openrouter/openai/gpt-oss-120b).
OPENROUTER_API_KEY=sk-or-v1-...

# Only for --runtime modal. Create with `modal token new`.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# Claude Code and Codex can also run on a Claude or ChatGPT subscription. They
# then use the credentials stored by `claude` and `codex` on this machine; set
# these only to override them (e.g. a long-lived token from `claude setup-token`).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CODEX_ACCESS_TOKEN=...

# Where the task images live (default ~/.cache/instrumental-evasion/images).
# IE_IMAGE_DIR=/path/to/images

# Agent CLIs, if not on PATH. Codex must be a package install
# (scripts/install_codex.sh), not a bare binary.
# CODEX_BIN=/path/to/codex
# HOOK_CLAUDE_BIN=/path/to/claude

# Relocatable CPython that runs the tool-call hook inside task containers
# (default: uv's cpython-3.12.13 under ~/.local/share/uv/python).
# HOOK_STANDALONE_PYTHON=/path/to/cpython-3.12.13-linux-x86_64-gnu
